{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0a0d12",
    "panel": "#0f141c",
    "element": "#121821",
    "line": "#1a2230",
    "ink": "#e8eef8",
    "muted": "#8b96a8",
    "faint": "#5a6578",
    "accent": "#5c9cf5",
    "ok": "#7dcea0",
    "warn": "#e6b35c",
    "cool": "#c9896b",
    "error": "#e06c75",
    "info": "#5c9cf5"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "muted", "light": "muted" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "error", "light": "error" },
    "warning": { "dark": "warn", "light": "cool" },
    "success": { "dark": "ok", "light": "ok" },
    "info": { "dark": "info", "light": "info" },
    "text": { "dark": "ink", "light": "ink" },
    "textMuted": { "dark": "muted", "light": "faint" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "line", "light": "line" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "line", "light": "line" },
    "diffAdded": { "dark": "ok", "light": "ok" },
    "diffRemoved": { "dark": "error", "light": "error" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "faint", "light": "faint" },
    "diffHighlightAdded": { "dark": "ok", "light": "ok" },
    "diffHighlightRemoved": { "dark": "error", "light": "error" },
    "diffAddedBg": { "dark": "#14201a", "light": "#14201a" },
    "diffRemovedBg": { "dark": "#201418", "light": "#201418" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "faint", "light": "faint" },
    "diffAddedLineNumberBg": { "dark": "#14201a", "light": "#14201a" },
    "diffRemovedLineNumberBg": { "dark": "#201418", "light": "#201418" },
    "markdownText": { "dark": "ink", "light": "ink" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "accent", "light": "accent" },
    "markdownLinkText": { "dark": "info", "light": "info" },
    "markdownCode": { "dark": "ok", "light": "ok" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "warn", "light": "warn" },
    "markdownStrong": { "dark": "warn", "light": "warn" },
    "markdownHorizontalRule": { "dark": "faint", "light": "faint" },
    "markdownListItem": { "dark": "accent", "light": "accent" },
    "markdownListEnumeration": { "dark": "ok", "light": "ok" },
    "markdownImage": { "dark": "accent", "light": "accent" },
    "markdownImageText": { "dark": "info", "light": "info" },
    "markdownCodeBlock": { "dark": "ink", "light": "ink" },
    "syntaxComment": { "dark": "faint", "light": "faint" },
    "syntaxKeyword": { "dark": "accent", "light": "accent" },
    "syntaxFunction": { "dark": "info", "light": "info" },
    "syntaxVariable": { "dark": "ok", "light": "ok" },
    "syntaxString": { "dark": "ok", "light": "ok" },
    "syntaxNumber": { "dark": "warn", "light": "warn" },
    "syntaxType": { "dark": "cool", "light": "cool" },
    "syntaxOperator": { "dark": "muted", "light": "muted" },
    "syntaxPunctuation": { "dark": "ink", "light": "ink" }
  }
}
