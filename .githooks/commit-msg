#!/bin/sh
# Strip agent co-author trailers before the commit is written.
#
# Cursor's agent and Claude Code add `Co-authored-by: Cursor
# <cursoragent@cursor.com>` / `Co-Authored-By: Claude Opus 5
# <noreply@anthropic.com>` to commits they make. GitHub maps those addresses
# to real accounts and lists them in the repository's Contributors panel,
# where they outnumbered the humans who maintain the project (2026-09-22:
# @cursoragent and @claude beside the two people). The work is the author's;
# the tool used to write it is not a contributor.
#
# Dropped: a trailer whose ADDRESS is an agent's, or whose NAME is exactly
# the tool ("Cursor", "Cursor Agent", "Claude", "Claude Code", "Claude
# <model>"). A human co-author and every other trailer are untouched.
#
# Install once per clone: git config core.hooksPath .githooks
[ -n "$1" ] || exit 0

agent='^[[:space:]]*co-authored-by:[[:space:]]*([^<]*<[[:space:]]*(cursoragent@cursor\.com|cursor@cursor\.com|noreply@anthropic\.com)[[:space:]]*>|(cursor([[:space:]]+agent)?|claude([[:space:]]+(code|opus|sonnet|haiku|fable)[^<]*)?)[[:space:]]*<)'

tmp="$1.captain"
if grep -viE "$agent" "$1" > "$tmp"; then
	if cmp -s "$1" "$tmp"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$1"
		echo "captain: dropped an agent co-author trailer (.githooks/commit-msg)" >&2
	fi
else
	rm -f "$tmp" # grep found nothing to keep, or failed: leave the message alone
fi
# Refuse a message that names a private project, paper, person or tool.
# Only a captain that knows leakcheck is called: an older one runs an unknown
# word as a task on a model.
c=$(command -v captain 2>/dev/null)
if [ -n "$c" ] && LC_ALL=C grep -a -q 'captain leakcheck:' "$c" 2>/dev/null; then
	captain leakcheck --message-file "$1" || exit 1
fi
exit 0
