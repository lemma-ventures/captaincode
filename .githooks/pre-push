#!/bin/sh
# Refuse a push whose commits - messages, added lines or paths - name a
# private project, paper, person or tool (captain leakcheck). The last gate
# before the public repository: it also catches commits made without the
# pre-commit hook, or brought in from another clone.
#
# Install once per clone: git config core.hooksPath .githooks
# An older captain has no leakcheck, and treats an unknown word as a task to
# run on a model: "captain leakcheck" would start a worker. Only a binary that
# knows the command is called.
c=$(command -v captain) || { echo "captain: not on PATH - private-name check skipped" >&2; exit 0; }
LC_ALL=C grep -a -q 'captain leakcheck:' "$c" 2>/dev/null || { echo "captain: $c predates leakcheck - private-name check skipped; run ./captaincode.sh -rr" >&2; exit 0; }
exec captain leakcheck --pre-push
