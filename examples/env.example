# Captain Code environment - copy to ~/.config/captain/env
# `captain init` scaffolds this file; every line below is optional.
# Credentials themselves do NOT belong here unless a provider needs them at
# process level: opencode stores provider auth via `opencode auth login`, and
# the vendor CLIs manage their own.

# --- routing -----------------------------------------------------------------
# First entry directs and is excluded from the worker pool.
# `captain init` writes values derived from what is on PATH (claude preferred for
# director when present; first installed worker for fallback).
CAPTAIN_DIRECTOR=claude
# Allowlist. Unset = every registry leg. A leg outside it still runs when forced.
CAPTAIN_LEGS=free,grok,glm,gemini,deepseek,cursor,codex-cli,claude
# A frontier director plans slower than the default route budget allows.
CAPTAIN_ROUTE_TIMEOUT_MS=30000
CAPTAIN_FALLBACK_LEG=cursor

# --- workers -----------------------------------------------------------------
# CAPTAIN_WORKER_TIMEOUT=15m
# CAPTAIN_WORKER_STALL_TIMEOUT=4m
# CAPTAIN_CWD=/path/to/the/repository/you/are/working/in

# --- context -----------------------------------------------------------------
# CAPTAIN_COMPACT_LEG=gemini

# --- provider keys used by opencode providers that read the environment -------
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# TypeSafe Jev, the decision leg: triage classification in ~100-500ms (`captain jev`).
# Or drop the console download (a one-line API_KEY=…) in as ~/.config/captain/jev.env, like aa.env.
# TYPESAFE_API_KEY=
# CAPTAIN_TRIAGE_JEV_BELOW=0.9   # ask jev while the heuristic is under this (0: only under CAPTAIN_TRIAGE_CONF)
# Only for `captain priors sync`:
# CAPTAIN_AA_API_KEY=
