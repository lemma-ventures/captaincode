/captain
/cmd/captaincode/captaincode
*.env
.env.*
*.keys
.DS_Store
.euclid/

# Local opencode install / plugin cache under the checkout (not product source).
.opencode/

# The panels' dependencies: `cd plugin/captain-ui && bun install` restores them
# from bun.lock, which is committed so that install is reproducible.
plugin/captain-ui/node_modules/
plugin/*.log

# screenshots and scratch the user drops in for a conversation, never product
gitignore/

# The sidecar is Python; running it in the checkout leaves bytecode behind.
__pycache__/
